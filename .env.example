# Copie para .env e preencha:  cp .env.example .env
# Um único agente (consumer); a base de conhecimento vive no branch `data`.

# ── LLM ──
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Chave do Ollama Cloud (https://ollama.com) — necessária apenas quando
# OLLAMA_BASE_URL aponta para a nuvem; o Ollama local ignora a chave.
OLLAMA_API_KEY=

# Para OpenAI-compatible (OpenAI, Azure, OpenRouter, qualquer proxy estilo OpenAI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Servidor ──
AGENT_CONFIG_DIR=.consumer
HOST=0.0.0.0
PORT=8000

# ── Acesso administrativo ──
# Não há credencial padrão: sem as três variáveis abaixo, /auth e /kb ficam
# indisponíveis. Gere o hash com:
#   uv run python scripts/hash_admin_password.py
# Gere o segredo com um gerenciador seguro (mínimo de 32 bytes).
CHAT_CSA_ADMIN_USERNAME=
CHAT_CSA_ADMIN_PASSWORD_HASH=
CHAT_CSA_AUTH_SECRET=
# Segredo opcional e exclusivo para criptografar perguntas sem resposta.
# Se vazio, o backend deriva a chave de CHAT_CSA_AUTH_SECRET.
CHAT_CSA_UNANSWERED_SECRET=
# Validade da sessão em segundos (padrão: 8 horas; mínimo: 5 min; máximo: 7 dias).
CHAT_CSA_AUTH_SESSION_TTL=28800
# Origens autorizadas, separadas por vírgula. Inclua o domínio público do frontend.
CHAT_CSA_CORS_ORIGINS=http://localhost:5173

# ── Base de conhecimento remota (branch `data`) ──
# KB_BACKEND=github no deploy; use local para dev/testes sem rede.
KB_BACKEND=github
KB_REPO=cldaniel101/chat-csa
KB_BRANCH=data
# Prefixo dentro do branch (vazio = bundle na raiz).
KB_ROOT=
# Token de leitura (fine-grained, contents:read). Vazio = repo público.
KB_TOKEN=
# Token de escrita (contents:write) — só o servidor usa, para /kb/upload.
# Fallback: KB_TOKEN quando ele tiver escopo de escrita.
KB_WRITE_TOKEN=
# TTL do cache em memória, em segundos (0 desliga).
KB_CACHE_TTL=60
# Backend local (dev/testes): diretório da base (gitignored).
KB_LOCAL_PATH=knowledge

# ── Conversão do upload (kb) ──
# Modelo multimodal usado na conversão do /kb/upload (vazio = LLM_MODEL do serviço).
KB_CONVERT_MODEL=
# Páginas por chamada multimodal na conversão de PDF (orçamento de contexto).
KB_CONVERT_PAGES_PER_CALL=4
# Orçamento de bytes por arquivo no upload (teto do corpo da Vercel ~4.5 MB).
KB_UPLOAD_MAX_BYTES=4500000

# ── Ferramentas do portal CSA (desligadas por padrão) ──
CHAT_CSA_PORTAL_TOOLS=0

# ── Aviso de atualização do portal (somente backend/automação) ──
# Endpoint HTTPS da API de e-mail, token Bearer e destinatário da curadoria.
# No GitHub Actions, cadastre as três chaves como repository secrets.
CHAT_CSA_EMAIL_API_URL=
CHAT_CSA_EMAIL_API_TOKEN=
CHAT_CSA_UPDATE_NOTIFICATION_TO=

# ── Frontend (React) ──
FRONTEND_PORT=5173
# VITE_CONSUMER_URL=http://localhost:8002

# ── FAQ curada (lida da base remota) ──
# CHAT_CSA_QA_CACHE_PATHS=perguntas-frequentes/
# CHAT_CSA_QA_CACHE_ENABLED=1
# CHAT_CSA_QA_CACHE_MIN_SCORE=0.68
