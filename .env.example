# Copie para .env e preencha:  cp .env.example .env
# Cada agente é um processo/serviço separado com seu próprio dir AGENTS.md + skills/.
# AGENT_CONFIG_DIR é por processo (.ingester OU .consumer), não global.
# Para `make run-both` / `docker compose up` você precisa dos DOIS config dirs — veja abaixo.

# ── Padrões de LLM compartilhados (usados por ambos os agentes, salvo override por agente) ──
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Chave do Ollama Cloud (https://ollama.com) — necessária apenas quando
# OLLAMA_BASE_URL aponta para a nuvem; o Ollama local ignora a chave.
OLLAMA_API_KEY=

# Para OpenAI-compatible (OpenAI, Azure, OpenRouter, qualquer proxy estilo OpenAI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Modo de agente único (um processo) ──
# `uv run chat-csa serve --config-dir .ingester --port 8001`
# ou defina AGENT_CONFIG_DIR e rode `uv run chat-csa serve`
AGENT_CONFIG_DIR=.ingester
HOST=0.0.0.0
PORT=8000

# ── Modo de dois agentes (dois processos lado a lado) ──
# `make run-both`  e  `docker compose up`  usam estes.
# Cada agente mantém seu próprio config dir (seu .agents customizado) + porta + modelo.
INGESTER_CONFIG_DIR=.ingester
INGESTER_PORT=8001
#INGESTER_LLM_PROVIDER=ollama
#INGESTER_LLM_MODEL=gemma4:31b-cloud
#INGESTER_OPENAI_API_KEY=sk-...
#INGESTER_HOST=0.0.0.0

CONSUMER_CONFIG_DIR=.consumer
CONSUMER_PORT=8002
#CONSUMER_LLM_PROVIDER=ollama
#CONSUMER_LLM_MODEL=gemma4:31b-cloud
#CONSUMER_OPENAI_API_KEY=sk-...
#CONSUMER_HOST=0.0.0.0

# ── Frontend (React) ──
FRONTEND_PORT=5173
# O frontend é exclusivo do consumer; o painel do ingester vive no próprio
# backend em FastHTML (/admin) — sem VITE_INGESTER_URL.
# VITE_CONSUMER_URL=http://localhost:8002

# ── Ferramentas ──
# CHAT_CSA_ALLOW_ABSOLUTE=0  # 1 = permite caminhos absolutos fora do cwd
